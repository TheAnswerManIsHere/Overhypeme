modules = ["nodejs-24", "python-3.11", "postgresql-16"]

# Claude Code (installed in the Repl shell) keeps its user config — OAuth
# credentials, session history — in the workspace so it survives Repl
# restarts ($HOME does not persist). The directory is gitignored; see
# .gitignore for why that entry is load-bearing in a public repo.
[env]
CLAUDE_CONFIG_DIR = "/home/runner/workspace/.claude-user"

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "sentry-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/overhype-me test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "db-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "git-lock-watcher"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/dev-supervisor.sh git-lock-watcher bash -c 'while true; do bash scripts/clean-stale-git-locks.sh; sleep \"${GIT_LOCK_WATCHER_INTERVAL:-10}\"; done'"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "git-lock-cleaner-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/__tests__/clean-stale-git-locks.test.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "dev-supervisor-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/__tests__/dev-supervisor.test.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "check-snapshots"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db check-snapshots"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/overhype-me: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/chuck-norris-facts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/overhype-me run dev"
cwd = "./artifacts/overhype-me"
waitForPort = 26169
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "26169"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]

[userenv.shared]
RESEND_FROM_EMAIL = "noreply@overhype.me"
VITE_GA_MEASUREMENT_ID = "G-QYCH0VLMB3"
STRIPE_ACCOUNT_ID_TEST = "acct_1TGbDFBoYd2wqzWn"
STRIPE_ACCOUNT_ID_LIVE = "acct_1TGk96PUPouDdcHb"
ALLOWED_ORIGINS = "https://overhype.me,https://overhypeme.replit.app"

[userenv.development]
TEST_DATABASE_URL = "postgresql://postgres:password@helium/heliumdb_test?sslmode=disable"
TEST_SHARDS = "4"

[objectStorage]
defaultBucketID = "replit-objstore-ae743525-77de-4797-8785-8a65fa3c45c3"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 26169
externalPort = 3000
