{
  "model": "opus",
  "env": {
    "DATABASE_URL": "postgres://overhype:overhype@localhost:5432/overhype_test"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__send_later",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__create_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__update_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_triggers",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__delete_trigger",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__fire_trigger"
    ],
    "deny": [
      "Bash(drizzle-kit push*)",
      "Bash(pnpm drizzle-kit push*)",
      "Bash(npx drizzle-kit push*)",
      "Read(**/.env*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Trigger-family MCP tools on the Claude Code Remote server — send_later, create_trigger, update_trigger, delete_trigger, list_triggers, fire_trigger — are pre-approved under ANY server prefix (mcp__Claude_Code_Remote__*, mcp__claude-code-remote__*, or a per-environment UUID prefix such as mcp__bf7c680d-...__*). The repository owner (David) has given standing consent for agents to create, update, fire, list, and cancel their own scheduled check-in Routines during autonomous work in this repository; these calls must not prompt for approval. This consent covers Routine/trigger management only — it does not extend to any other tool."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/setup-test-db.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
