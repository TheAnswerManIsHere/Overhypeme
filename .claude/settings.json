{
  "model": "claude-sonnet-5",
  "env": {
    "DATABASE_URL": "postgres://overhype:overhype@localhost:5432/overhype_test"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(drizzle-kit push*)",
      "Bash(pnpm drizzle-kit push*)",
      "Bash(npx drizzle-kit push*)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/setup-test-db.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
