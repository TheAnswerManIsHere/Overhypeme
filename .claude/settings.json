{
  "env": {
    "DATABASE_URL": "postgres://overhype:overhype@localhost:5432/overhype_test"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm run *)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(node *)",
      "Bash(tsx *)",
      "Bash(pnpm drizzle-kit generate*)",
      "Bash(pnpm drizzle-kit migrate*)",
      "Bash(pnpm drizzle-kit check*)",
      "Bash(pnpm drizzle-kit studio*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git merge *)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git stash*)"
    ],
    "deny": [
      "Bash(drizzle-kit push)",
      "Bash(drizzle-kit push *)",
      "Bash(pnpm drizzle-kit push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/setup-test-db.sh"
          }
        ]
      }
    ]
  }
}
